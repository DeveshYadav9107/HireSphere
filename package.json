{
  "name": "hiresphere-portal",
  "version": "1.0.0",
  "private": true,
  "description": "HireSphere - Complete Naukri-Inspired Job Portal Full Stack Application",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "npm --prefix server run dev",
    "client:dev": "npm --prefix client run dev",
    "server": "npm --prefix server start",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "postinstall": "npm --prefix server run prisma:generate",
    "start": "npm --prefix server start",
    "seed": "npm --prefix server run seed"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
