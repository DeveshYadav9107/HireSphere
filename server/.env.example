# ============================================================
# HireSphere Production & Local Environment Configuration
# ============================================================

PORT=5000
NODE_ENV=development

# ------------------------------------------------------------
# Database URL:
# ------------------------------------------------------------
# 1) SQLite (Default for zero-setup local development):
DATABASE_URL="file:./dev.db"

# 2) PostgreSQL (For Production on Supabase, Neon, Render, Railway, AWS RDS):
# To switch to PostgreSQL:
# - Change provider = "postgresql" in server/prisma/schema.prisma
# - Uncomment and set your connection string below:
# DATABASE_URL="postgresql://postgres:your_password@ep-sample-1234.us-east-2.aws.neon.tech/hiresphere?sslmode=require"

# ------------------------------------------------------------
# Authentication Security:
# ------------------------------------------------------------
# Generate a strong 32+ character random string in production (e.g. openssl rand -base64 32):
JWT_SECRET="hiresphere_super_secret_jwt_key_2026_production_change_me"

# ------------------------------------------------------------
# Client Origin URL (For separated frontend & backend deployments):
# ------------------------------------------------------------
CLIENT_URL="http://localhost:5173"
# In production on separate domain:
# CLIENT_URL="https://hiresphere.vercel.app"

# ------------------------------------------------------------
# Optional Email SMTP Settings:
# ------------------------------------------------------------
# SMTP_HOST="smtp.mailtrap.io"
# SMTP_PORT=2525
# SMTP_USER="your_smtp_user"
# SMTP_PASS="your_smtp_pass"
# SMTP_FROM="noreply@hiresphere.com"
